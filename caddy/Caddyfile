# ==============================================================================
# Caddy Reverse Proxy Configuration for Social Network Pathfinding Engine
#
# Features:
# 1. Configurable site address: use a hostname for automatic TLS or :80 for HTTP
# 2. Reverse Proxy: forwards requests internally to api:5000
# 3. Metrics are denied at ingress before requests reach the API
# 4. Security headers: HSTS, nosniff, frame protection, and referrer policy
# ==============================================================================

{$SITE_ADDRESS:localhost} {
    # Metrics are scraped only on the Docker network, never through public ingress.
    @metrics path /metrics /metrics/*
    respond @metrics 404

    # Reverse proxy to the FastAPI container on the internal Docker network
    reverse_proxy api:5000 {
        header_up Host {upstream_hostport}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Modern Security Headers
    header {
        # HTTP Strict Transport Security (HSTS)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"
        # Clickjacking mitigation
        X-Frame-Options "DENY"
        # Referrer privacy
        Referrer-Policy "strict-origin-when-cross-origin"
        # Remove server identifier disclosure
        -Server
    }

    # Logging configuration
    log {
        output stdout
        format console
    }
}

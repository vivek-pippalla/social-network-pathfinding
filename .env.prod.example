# ==============================================================================
# Production Environment Variables (.env.prod)
# Template for EC2 Deployment (Keep chmod 600 outside Git and Docker images)
# ==============================================================================

# AWS Configuration
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012
IMAGE_TAG=latest

# Neo4j Production Configuration
NEO4J_PASSWORD=GENERATE_STRONG_RANDOM_PASSWORD_HERE

# JWT Signing Secret (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=GENERATE_STRONG_RANDOM_JWT_SECRET_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis Cache Settings
CACHE_TTL_SECONDS=3600

# S3 Dataset Ingestion (private bucket)
AWS_S3_BUCKET=my-social-network-datasets-prod
AWS_S3_DATASET_KEY=datasets/facebook_combined.txt.gz

# Centralized CloudWatch Logging
CLOUDWATCH_ENABLED=true
CLOUDWATCH_LOG_GROUP=/social-network-pathfinding/app

# Caddy Reverse Proxy & Automatic HTTPS Configuration
# Set to your EC2 public IP with sslip.io (e.g. 13.233.45.67.sslip.io) or custom domain
DOMAIN_NAME=your-ec2-public-ip.sslip.io

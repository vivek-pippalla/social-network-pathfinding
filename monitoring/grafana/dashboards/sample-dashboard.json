{
  "dashboard": {
    "id": null,
    "uid": "social-network-api",
    "title": "Social Network API Observability",
    "tags": ["fastapi", "social-network"],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "10s",
    "time": { "from": "now-1h", "to": "now" },
    "panels": [
      {
        "id": 1,
        "type": "timeseries",
        "title": "Request rate",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "targets": [{ "expr": "sum by (handler) (rate(http_requests_total[5m]))", "legendFormat": "{{handler}}" }],
        "fieldConfig": { "defaults": { "unit": "reqps" } }
      },
      {
        "id": 2,
        "type": "timeseries",
        "title": "HTTP error rate",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "targets": [{ "expr": "100 * sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 1e-9)", "legendFormat": "5xx percent" }],
        "fieldConfig": { "defaults": { "unit": "percent" } }
      },
      {
        "id": 3,
        "type": "timeseries",
        "title": "HTTP latency percentiles",
        "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
        "targets": [
          { "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
          { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" },
          { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99" }
        ],
        "fieldConfig": { "defaults": { "unit": "s" } }
      },
      {
        "id": 4,
        "type": "timeseries",
        "title": "Path cache hit ratio",
        "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
        "targets": [{ "expr": "sum(rate(path_cache_operations_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(path_cache_operations_total{result=~\"hit|miss\"}[5m])), 1e-9)", "legendFormat": "hit ratio" }],
        "fieldConfig": { "defaults": { "unit": "percentunit" } }
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "Neo4j query latency p95 by operation",
        "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
        "targets": [{ "expr": "histogram_quantile(0.95, sum by (operation, le) (rate(neo4j_query_duration_seconds_bucket[5m])))", "legendFormat": "{{operation}}" }],
        "fieldConfig": { "defaults": { "unit": "s" } }
      }
    ]
  },
  "overwrite": true
}

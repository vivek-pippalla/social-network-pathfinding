# Copy to .env and replace the deliberately invalid secret placeholders.
APP_ENV=dev
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-private-password
# Generate a value with: openssl rand -hex 24
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace-with-at-least-32-random-characters
API_IMAGE=social-network-api:local
WEB_CONCURRENCY=2
# The prod-like edge network is dedicated to Caddy; update with EDGE_NETWORK_SUBNET.
TRUSTED_PROXY_ADDRESSES=172.29.0.0/24
EDGE_NETWORK_SUBNET=172.29.0.0/24
SITE_ADDRESS=:80
NEO4J_HEAP_MAX=1G
NEO4J_HEAP_INITIAL=512M
NEO4J_PAGECACHE=512M
ALGORITHM=HS256
MAX_PATH_DEPTH=6
NEO4J_QUERY_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=0.2
CACHE_TTL_SECONDS=300
NEGATIVE_CACHE_TTL_SECONDS=60
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAX_REQUEST_BODY_BYTES=1048576
ENABLE_DOCS=true
AUTO_SCHEMA=true
# Comma-separated origins; empty disables CORS middleware.
ALLOWED_ORIGINS=
# Monitoring profile only: replace both placeholders before enabling it.
GRAFANA_ADMIN_USER=replace-with-a-grafana-admin-user
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-grafana-password

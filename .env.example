# Copy to .env and replace the deliberately invalid secret placeholders.
APP_ENV=dev
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-private-password
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-at-least-32-random-characters
ALGORITHM=HS256
MAX_PATH_DEPTH=6
NEO4J_QUERY_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=0.2
CACHE_TTL_SECONDS=300
NEGATIVE_CACHE_TTL_SECONDS=60
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENABLE_DOCS=true
AUTO_SCHEMA=true
# Comma-separated origins; empty disables CORS middleware.
ALLOWED_ORIGINS=

# Legacy optional ingestion/logging settings. AWS packages are not needed by the API.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_S3_DATASET_KEY=datasets/facebook_combined.txt.gz
CLOUDWATCH_ENABLED=false
CLOUDWATCH_LOG_GROUP=/social-network-pathfinding/app
CLOUDWATCH_LOG_RETENTION_DAYS=14

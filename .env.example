# ─── Neo4j ────────────────────────────────────────────────────────────────────
# Use bolt://neo4j:7687 inside Docker Compose (service name = hostname)
# Use bolt://localhost:7687 for local dev without Docker
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Cache ────────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=3600

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── AWS ──────────────────────────────────────────────────────────────────────
# Only required when running on EC2 or using S3/CloudWatch locally.
# On EC2 with an IAM instance role, leave AWS_ACCESS_KEY_ID / SECRET blank —
# boto3 picks up the role automatically. Never commit real keys.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-bucket-name-here
AWS_S3_DATASET_KEY=datasets/facebook_combined.txt.gz

# CloudWatch log shipping
# Set to true only on EC2; leave false for local dev.
CLOUDWATCH_ENABLED=false
CLOUDWATCH_LOG_GROUP=/social-network-pathfinding/app

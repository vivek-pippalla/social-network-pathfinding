{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBackupAndArtifactPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<BUCKET_NAME>",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "backups/*",
            "artifacts/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadWriteBackups",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::<BUCKET_NAME>/backups/*"
    },
    {
      "Sid": "ReadReleaseArtifacts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<BUCKET_NAME>/artifacts/*"
    },
    {
      "Sid": "WriteContainerLogsToOneGroup",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:/pathfinding-demo:*"
    }
  ]
}

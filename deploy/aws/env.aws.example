# Copy to .env on the instance, chmod 600, and replace every CHANGE_ME value. Never commit the result.
APP_ENV=prod
ENABLE_DOCS=false
SECRET_KEY=CHANGE_ME_GENERATE_ON_THE_INSTANCE
NEO4J_PASSWORD=CHANGE_ME_GENERATE_ON_THE_INSTANCE
REDIS_PASSWORD=CHANGE_ME_GENERATE_ON_THE_INSTANCE

# Sizing: see Phase 15, section 15.3 (start values, then measure)
WEB_CONCURRENCY=2
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512M

# Edge: plain HTTP on port 80, restricted to your IP by the security group
SITE_ADDRESS=:80
COMPOSE_PROFILES=edge
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml:deploy/aws/docker-compose.aws.yml

# AWS (used by the log driver and the backup scripts only; the app does not read these)
AWS_REGION=<REGION>
CW_LOG_GROUP=/pathfinding-demo
BACKUP_BUCKET=<BUCKET_NAME>
